# Environment variables for OrbWeather's weather alerts.
# Copy to .env.local for local work, and set the same names in Vercel:
# Project > Settings > Environment Variables. Never commit real values.

# Web Push signing keys. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret the scheduler sends to /api/check-weather.
# Any long random string, e.g.: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Upstash Redis (console.upstash.com > your database > REST API > .env).
# Vercel's Upstash integration names (KV_REST_API_URL / KV_REST_API_TOKEN) also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
